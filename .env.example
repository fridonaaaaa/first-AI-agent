# Copy to .env and fill in real values. NEVER commit .env.

# --- Required ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investigation_engine
ADMIN_TOKEN=replace-with-a-long-random-secret

# --- LLM (choose one free provider; leave the others blank) ---
LLM_PROVIDER=mock
LLM_MODEL=

GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Retrieval ---
RETRIEVAL_MODE=hybrid_rerank
RETRIEVAL_TOP_K=10
BM25_K1=1.5
BM25_B=0.75
RRF_K=60

# --- RAG pipeline ---
MAX_TOOL_STEPS=8
MAX_SUB_QUERIES=4
ABSTENTION_THRESHOLD=0.3

# --- Rate limiting ---
RATE_LIMIT_PER_IP_PER_MINUTE=20
DAILY_CAP_ASK=1000

# --- Misc ---
LLM_CACHE_DIR=.cache/llm
LOG_LEVEL=INFO
ENVIRONMENT=development
